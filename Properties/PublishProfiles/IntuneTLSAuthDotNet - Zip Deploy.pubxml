    <ResourceId>/subscriptions/15cdce4d-ed00-4531-8ef2-0a9fb75e5c02/resourceGroups/RG-IntuneTLSAuth/providers/Microsoft.Web/sites/IntuneTLSAuthDotNet</ResourceId>
    <IsLinux>true</IsLinux>
    <UseBlobContainerDeploy>true</UseBlobContainerDeploy>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishUrl>https://intunetlsauthdotnet.scm.azurewebsites.net/</PublishUrl>
  </PropertyGroup>
</Project>